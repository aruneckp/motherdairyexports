# Copy to .env and set your own values. On Render, set the same keys under
# Environment instead. They are read when the app is BUILT, so rebuild/redeploy
# after changing them.

# Sign-in for the export portal (username is not case-sensitive).
# Only a salted hash of the password goes into the built app, never the password.
APP_USERNAME=admin
APP_PASSWORD=change-me

# How long a sign-in lasts, in hours (default 12)
SESSION_HOURS=12
