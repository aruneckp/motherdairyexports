# Copy to .env and set your own values. These are read only by the server
# (no VITE_ prefix), so they are never shipped in the browser bundle.

# Sign-in for the export portal (username is not case-sensitive)
APP_USERNAME=admin
APP_PASSWORD=change-me

# Signs session cookies. Use a long random string, e.g. `openssl rand -hex 32`.
# If left empty, everyone is signed out whenever the server restarts.
SESSION_SECRET=

# How long a sign-in lasts, in hours (default 12)
SESSION_HOURS=12

# Port for `npm start` (production server)
PORT=4173
